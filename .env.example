POSTGRES_USER=ingestor
POSTGRES_PASSWORD=ingestor
POSTGRES_DB=sensors
POSTGRES_PORT=5432

# Optional tuning (see config/pipeline.yaml): worker processes and rows per transaction.
WORKERS=4
BATCH_SIZE=10000

# Used by the app when run on the host (make test, local runs).
# Inside docker compose the app reaches the database at host "db" instead.
DATABASE_URL=postgresql://ingestor:ingestor@localhost:5432/sensors
